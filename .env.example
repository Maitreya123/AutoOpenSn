# AutoOpenSn - environment configuration
# Copy this file to .env and add your API keys. Never commit .env.
#
# The two LLM stages in autoopensn/narrate/ reuse the sister repository's
# LLMClient, which reads these same variables. The deterministic middle of the
# pipeline (spec -> render -> run -> parse) needs none of them.

# TAMU AI Chat API (primary).
# Get a key from https://chat.tamu.ai/
#
TAMU_API_KEY=your-tamu-api-key-here

# If the key above appears to be ignored, check whether your shell exports
# TAMU_API_KEY already: an exported variable wins over one set in .env, so a
# key placed here under that name would be silently overridden. The sister
# repository reads a second name first, to sidestep exactly that collision:
#
#   TAMU_assintant_key=your-tamu-api-key-here
#
# The misspelling is upstream's, in Code_assistant_TAU/src/llm_client.py, and
# is reproduced here rather than corrected because it is the name the code
# actually looks for. Only set it if TAMU_API_KEY does not take effect.

# Optional. Model served by the TAMU gateway; defaults to the sister
# repository's configured model.
# TAMU_MODEL=protected.gpt-5.5

# Groq API (fallback).
# Get a key from https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# Path to the sister repository (the OpenSn documentation assistant), used by
# autoopensn/kp_bridge.py to locate the knowledge pack and the pinned OpenSn
# checkout. Defaults to ../Code_assistant_TAU relative to this repository.
# AUTOOPENSN_KP_REPO=/absolute/path/to/Code_assistant_TAU

# Set to 1 to allow tests to invoke the real LocalMPIRunner. Off by default:
# the whole suite must pass with no OpenSn installed.
# AUTOOPENSN_ALLOW_LOCAL_RUNS=0
