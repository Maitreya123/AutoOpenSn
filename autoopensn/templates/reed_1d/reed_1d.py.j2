#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# {{ header_comment | pycomment }}

import os
import sys

if "opensn_console" not in globals():
    from mpi4py import MPI
    size = MPI.COMM_WORLD.size
    rank = MPI.COMM_WORLD.rank
    sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), {{ pyopensn_path | pystr }})))
    from pyopensn.mesh import OrthogonalMeshGenerator
    from pyopensn.xs import MultiGroupXS
    from pyopensn.source import VolumetricSource
    from pyopensn.aquad import GLProductQuadrature1DSlab
    from pyopensn.solver import DiscreteOrdinatesProblem, SteadyStateSourceSolver
    from pyopensn.logvol import RPPLogicalVolume
{% if emit_avg_flux %}
    from pyopensn.fieldfunc import FieldFunctionInterpolationVolume
{% endif %}

if __name__ == "__main__":

    # Create Mesh
    widths = [{{ widths | dotlist }}]
    nrefs = [{{ nrefs | intlist }}]
    Nmat = len(widths)
    nodes = [0.]
    for imat in range(Nmat):
        dx = widths[imat] / nrefs[imat]
        for i in range(nrefs[imat]):
            nodes.append(nodes[-1] + dx)
    meshgen = OrthogonalMeshGenerator(node_sets=[nodes])
    grid = meshgen.Execute()

    # Set block IDs
    z_min = 0.0
    z_max = widths[1]
    for imat in range(Nmat):
        z_max = z_min + widths[imat]
        if rank == 0:
            print("imat=", imat, ", zmin=", z_min, ", zmax=", z_max)
        lv = RPPLogicalVolume(infx=True, infy=True, zmin=z_min, zmax=z_max)
        grid.SetBlockIDFromLogicalVolume(lv, imat, True)
        z_min = z_max

    # Add cross sections to materials
    total = [{{ total | dotlist }}]
    c = [{{ c | dotlist }}]
    xs_map = len(total) * [None]
    for imat in range(Nmat):
        xs_ = MultiGroupXS()
        xs_.CreateSimpleOneGroup(total[imat], c[imat])
        xs_map[imat] = {
            "block_ids": [imat], "xs": xs_,
        }

    # Create sources in 1st and 4th materials
    src0 = VolumetricSource(block_ids=[0], group_strength=[{{ src_block0_strength | dotf }}])
    src1 = VolumetricSource(block_ids=[3], group_strength=[{{ src_block3_strength | dotf }}])

    # Angular Quadrature
    gl_quad = GLProductQuadrature1DSlab(n_polar={{ n_polar | intf }}, scattering_order={{ scattering_order | intf }})

    # LBS block option
    num_groups = 1
    phys = DiscreteOrdinatesProblem(
        mesh=grid,
        num_groups=num_groups,
        groupsets=[
            {
                "groups_from_to": (0, num_groups - 1),
                "angular_quadrature": gl_quad,
                "inner_linear_method": {{ inner_linear_method | pystr }},
                "l_abs_tol": {{ l_abs_tol | sci }},
                "l_max_its": {{ l_max_its | intf }},
{% if inner_linear_method == "petsc_gmres" %}
                "gmres_restart_interval": {{ gmres_restart_interval | intf }},
{% endif %}
            },
        ],
        xs_map=xs_map,
        volumetric_sources=[src0, src1],
        boundary_conditions=[
            {"name": "zmin", "type": {{ bc_zmin_type | pystr }}},
            {"name": "zmax", "type": {{ bc_zmax_type | pystr }}}
        ],
{% if sweep_type != "AAH" %}
        sweep_type={{ sweep_type | pystr }},
{% endif %}
    )

    # Initialize and execute solver
    ss_solver = SteadyStateSourceSolver(problem=phys, compute_balance={{ compute_balance }})
    ss_solver.Initialize()
    ss_solver.Execute()

    balance = ss_solver.ComputeBalanceTable()
    if rank == 0:
        print(f"Absorption={balance['absorption_rate']:.6e}")
        print(f"OutFlow={balance['outflow_rate']:.6e}")
{% if emit_avg_flux %}

    # Volume-averaged scalar flux over the whole slab
    vol_all = RPPLogicalVolume(infx=True, infy=True, infz=True)
    ffi_avg = FieldFunctionInterpolationVolume()
    ffi_avg.SetOperationType("avg")
    ffi_avg.SetLogicalVolume(vol_all)
    ffi_avg.AddFieldFunction(phys.GetScalarFluxFieldFunction()[0])
    ffi_avg.Execute()
    if rank == 0:
        print(f"AvgFlux={ffi_avg.GetValue():.9e}")
{% endif %}
