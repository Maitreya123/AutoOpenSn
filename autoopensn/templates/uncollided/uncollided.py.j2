grid = make_mesh()
xs = make_xs()
whole_domain = make_whole_domain()

quadrature = GLCProductQuadrature3DXYZ(
    n_polar={{ n_polar | lit("int") }},
    n_azimuthal={{ n_azimuthal | lit("int") }},
    scattering_order={{ glcproduct_quadrature3_dxyz_scattering_order | lit("int") }},
)

problem = DiscreteOrdinatesProblem(
    mesh=grid,
    num_groups={{ discrete_ordinates_problem_num_groups | lit("int") }},
    groupsets=[
        {
            "groups_from_to": {{ groupset_groups_from_to | lit("list:int") }},
            "angular_quadrature": quadrature,
            "angle_aggregation_type": {{ angle_aggregation_type | lit("dq") }},
            "inner_linear_method": {{ inner_linear_method | lit("dq") }},
            "gmres_restart_interval": {{ gmres_restart_interval | lit("int") }},
            "l_abs_tol": {{ l_abs_tol | lit("sci") }},
            "l_max_its": {{ l_max_its | lit("int") }},
        }
    ],
    xs_map=[{"block_ids": {{ xs_map_block_ids_2 | lit("list:int") }}, "xs": xs}],
    uncollided_flux=str(uncollided_file),
)

solver = SteadyStateSourceSolver(problem=problem, compute_balance={{ compute_balance | lit("bool") }})
solver.Initialize()
solver.Execute()

scalar_flux = problem.GetScalarFluxFieldFunction()[0]
point_flux = point_value(scalar_flux, sample_point)
total_integral = volume_integral(scalar_flux, whole_domain)
balance = solver.ComputeBalanceTable()["balance"]

if rank == 0:
    print(f"Total scalar flux at {sample_point}: {point_flux:.12e}")
    print(f"Total scalar-flux integral: {total_integral:.12e}")
    print(f"Balance residual: {balance:.12e}")

